# Stage63 Nintendo Switch NRO build for the synthetic gameplay sandbox.
# Requires devkitPro/devkitA64/libnx. Does not package the Saturn ISO or assets.
.SUFFIXES:
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO to your devkitPro installation")
endif
TOPDIR ?= $(CURDIR)
include $(DEVKITPRO)/libnx/switch_rules

TARGET := thor2-stage63
APP_TITLE := Thor2 Native Sandbox
APP_AUTHOR := RIKITU LAB
APP_VERSION := 0.1.0
NO_ICON := 1
BUILD := build-switch
SOURCES := native/platform
INCLUDES := native

ARCH := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
LIBDIRS := $(PORTLIBS) $(LIBNX)
INCLUDE := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
           $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
           -I$(CURDIR)/$(BUILD)

CFLAGS := -g -Wall -Wextra -Werror -O2 -ffunction-sections -fdata-sections $(ARCH) $(INCLUDE) -D__SWITCH__
CXXFLAGS := $(CFLAGS) -std=gnu++17 -fexceptions
ASFLAGS := -g $(ARCH)
LDFLAGS = -specs=$(DEVKITPRO)/libnx/switch.specs -g $(ARCH) -Wl,-Map,$(notdir $*.map)
LIBS := -lnx -lstdc++ -lm
